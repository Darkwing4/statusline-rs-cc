            suffix: "",
            suffix_color: Rgb(203, 166, 247),
        ),
        PromptCacheTtl(
            color: Gradient,
            prefix: "cache ",
        ),
        RateLimit(
            window: FiveHour,
            style: Bar,
            fill: Remaining,
            color_mode: Gradient,
