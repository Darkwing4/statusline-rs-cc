{:paths ["src" "test"]
 :tasks
 {format-check {:doc "Check Clojure formatting with cljfmt 0.16.5 defaults"
                :task (shell "cljfmt check src test")}
  lint {:doc "Lint Clojure code with clj-kondo 2026.08.04"
        :task (shell "clj-kondo --lint src test bb.edn shadow-cljs.edn --cache false --repro")}
  check {:doc "Check formatting, lint, and the shared core"
         :depends [format-check lint test]}
  test {:doc "Run the pure core tests in babashka (needs segment-catalog.json: cargo run -- --schema > site/segment-catalog.json)"
        :requires ([clojure.test :as t])
        :task (do (require 'statusline-builder.catalogue-test
                           'statusline-builder.colour-test
                           'statusline-builder.editor-state-test
                           'statusline-builder.layout-test
                           'statusline-builder.preview-test
                           'statusline-builder.ron-test
                           'statusline-builder.shell-words-test)
                  (let [{:keys [fail error]} (t/run-all-tests (re-pattern "statusline-builder\\..*-test"))]
                    (when (pos? (+ fail error))
                      (System/exit 1))))}
  ron {:doc "Print a RON config with every segment on the line (needs segment-catalog.json: cargo run -- --schema > site/segment-catalog.json)"
       :task (do (require 'statusline-builder.every-segment-ron)
                 ((resolve 'statusline-builder.every-segment-ron/-main)))}}}
